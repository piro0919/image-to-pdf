{
  "name": "@piro0919/image-to-pdf",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:lib && next dev",
    "build": "pnpm build:lib && next build",
    "start": "next start",
    "build:lib": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike": "pnpm build:lib && node --env-file-if-exists=.env spike/run.ts",
    "spike:sample": "pnpm build:lib && node spike/make-sample.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build:lib",
    "lint": "eslint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@piro0919/eslint-config": "github:piro0919/eslint-config#v1.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vercel/analytics": "^2.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-hollow-tests": "^0.3.0",
    "knip": "^6.46.1",
    "lefthook": "^2.2.2",
    "next": "^16.4.6",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "secretlint": "^13.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.1"
  },
  "description": "Rebuild a photo of a paper document as a clean PDF with real text, tables and boxes, using Claude, OpenAI or Gemini with your own API key.",
  "license": "MIT",
  "author": "piro0919",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piro0919/image-to-pdf.git"
  },
  "homepage": "https://github.com/piro0919/image-to-pdf#readme",
  "keywords": [
    "ocr",
    "pdf",
    "handwriting",
    "document",
    "llm",
    "claude",
    "openai",
    "gemini"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@ai-sdk/google": "^4.0.122",
    "@ai-sdk/openai": "^4.0.121",
    "ai": "^7.0.177"
  }
}
